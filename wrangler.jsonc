{
  // Committed on purpose (2026-09-18) - without a real wrangler.jsonc in
  // the repo, `npx wrangler deploy` regenerates a throwaway one fresh
  // inside Cloudflare's build container on every single build (see
  // src/worker.ts's top comment), auto-declining Pages Functions setup
  // every time and silently dropping the /api/* routes. This file is what
  // makes the deploy deterministic instead of re-guessing project
  // structure on every build.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earlybird",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  // The Stripe SDK and @supabase/supabase-js both touch a few Node built-ins
  // internally even on code paths this project doesn't use (Buffer, etc) -
  // without this flag those imports fail at Worker startup rather than at
  // the one call site that might actually need them.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  // Plain (non-secret) runtime vars, committed directly here instead of
  // relying on the dashboard's "Variables and secrets" panel - Stripe price
  // IDs aren't sensitive (they're visible in checkout URLs to anyone), and
  // this guarantees every single `wrangler deploy` from CI actually has
  // them, rather than depending on whatever state the dashboard happens to
  // be in at deploy time (2026-09-18: dashboard-set vars weren't reliably
  // reaching the running Worker even after a fresh deploy).
  "vars": {
    "STRIPE_PRICE_MONTHLY": "price_1UGRMMACXmLhiaFCrNYFFYnT",
    "STRIPE_PRICE_SEMESTER": "price_1UGRMmACXmLhiaFCqKxnUMFU",
    // Added 2026-09-18 - this was missing entirely from the Worker's
    // environment (only ever set on Render, a completely separate
    // environment from this Cloudflare Worker), which is why every Supabase
    // call from inside the Worker (the webhook, /api/postings-full,
    // /api/request-login) was throwing "supabaseUrl is required." at
    // runtime. Not a secret - this is just the project's public REST API
    // base URL, safe to commit.
    "SUPABASE_URL": "https://dlonxlehlnazmidzkcuf.supabase.co",
    // Comma-separated codes that unlock the 14-day free trial in
    // /api/create-checkout-session (see checkout.ts) - anyone checking out
    // without one of these is charged immediately, no trial. Same
    // "dashboard vars don't reliably reach the Worker" reasoning as the
    // other vars here - add new codes by editing this list and pushing,
    // not via the Cloudflare dashboard.
    "TRIAL_CODES": "CPP20"
  }
}
